{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true
  },
  "include": [
    "../apps/controller/src/**/*.ts",
    "../apps/web/src/**/*.ts",
    "../apps/web/src/**/*.tsx",
    "../packages/contracts/src/**/*.ts",
    "../tests/**/*.ts",
    "../tests/native/*.mjs",
