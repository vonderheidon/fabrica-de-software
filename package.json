{
  "name": "nova-fabrica-software",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "imports": {
    "#contracts": {
      "types": "./packages/contracts/src/index.ts",
      "default": "./dist/packages/contracts/src/index.js"
    }
  },
  "scripts": {
    "proof:deletion-baseline": "vitest run --config vitest.deletion-baseline.config.ts --reporter=verbose",
    "test:browser:deletion": "node scripts/run-deletion-browser.mjs",
    "build": "tsc -p tsconfig.json && vite build && node scripts/copy-resources.mjs",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "lint": "node scripts/check-boundaries.mjs",
    "test": "vitest run",
    "test:compiled": "node scripts/smoke-compiled.mjs",
    "test:http": "vitest run --config vitest.http.config.ts",
    "test:execution-compiled": "node scripts/smoke-execution.mjs",
    "test:verification-compiled": "node scripts/smoke-verification.mjs",
    "test:acceptance": "vitest run tests/acceptance",
    "test:persistence": "vitest run tests/acceptance/persistence-maintenance.test.ts tests/acceptance/persistence-audit.test.ts tests/acceptance/execution-composition.test.ts tests/acceptance/persistence-report.test.ts tests/boundaries.test.ts --reporter=verbose",
    "proof:persistence": "node scripts/persistence-proof.mjs",
    "test:maintenance-native": "npm run build && vitest run --config vitest.maintenance.config.ts --reporter=verbose",
    "test:deletion-persistence": "vitest run --config vitest.deletion.config.ts tests/native/project-deletion.integration.proof.ts --reporter=verbose",
    "test:deletion-native": "vitest run --config vitest.deletion.config.ts --reporter=verbose",
    "acceptance:check": "node scripts/first-slice-evidence.mjs",
    "package:local": "npm run build && node scripts/package-distribution.mjs",
    "test:distribution": "node scripts/smoke-distribution.mjs",
    "start": "node scripts/start-host.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/static": "8.3.0",
    "@fastify/type-provider-typebox": "5.2.0",
    "@sinclair/typebox": "0.34.52",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.7",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "happy-dom": "20.8.4",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
